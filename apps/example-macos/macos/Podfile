ws_dir = Pathname.new(__dir__)
ws_dir = ws_dir.parent until
  File.exist?("#{ws_dir}/node_modules/react-native-test-app/macos/test_app.rb") ||
  ws_dir.expand_path.to_s == '/'
require "#{ws_dir}/node_modules/react-native-test-app/macos/test_app.rb"

workspace 'Example.xcworkspace'

platform :osx, '14.0'

# Dependencies with older podspec floors still compile for the app's minimum.
raise_pod_deployment_targets = ->(installer) do
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      current = config.build_settings['MACOSX_DEPLOYMENT_TARGET']
      next if current.nil? || Gem::Version.new(current) >= Gem::Version.new('14.0')

      config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '14.0'
    end
  end
end

use_test_app!(:hermes_enabled => true,
              :new_arch_enabled => true,
              :post_install => raise_pod_deployment_targets)
