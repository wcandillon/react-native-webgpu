{
  "extends": "eslint-config-react-native-wcandillon/tsconfig.base",
  "compilerOptions": {
    "paths": {
      "react-native-webgpu": ["../../packages/webgpu/src/index"],
      "three": ["../../node_modules/@types/three/src/Three.WebGPU.d.ts"],
      "three/addons/*": ["../../node_modules/@types/three/examples/jsm/*"]
    },
    "types": ["@webgpu/types", "@types/node"]
  },
  // Exclude the dormant Skia demo until SDK-based Dawn integration is available.
  // TypeScript replaces inherited exclude arrays, so keep the shared entries.
  "exclude": [
    "node_modules",
    "**/Pods/**",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "src/MNISTInference"
  ]
}
